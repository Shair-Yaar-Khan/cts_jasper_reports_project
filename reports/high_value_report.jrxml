<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="RejectedChequeReport"
    language="java"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <parameter
        name="P_STATUS"
        class="java.lang.String"/>

    <query language="sql">
        <![CDATA[
            SELECT
                cheque_number,
                customer_name,
                account_number,
                cheque_amount,
                rejection_reason
            FROM cheque_transaction
            WHERE status = $P{P_STATUS}
        ]]>
    </query>

    <field
        name="cheque_number"
        class="java.lang.String"/>

    <field
        name="customer_name"
        class="java.lang.String"/>

    <field
        name="account_number"
        class="java.lang.String"/>

    <field
        name="cheque_amount"
        class="java.math.BigDecimal"/>

    <field
        name="rejection_reason"
        class="java.lang.String"/>

    <title height="50">

        <element
            kind="staticText"
            x="0"
            y="10"
            width="555"
            height="30">

            <text><![CDATA[REJECTED CHEQUE REPORT]]></text>

        </element>

    </title>

    <columnHeader height="30">

        <element
            kind="staticText"
            x="0"
            width="100"
            height="30">

            <text><![CDATA[Cheque No]]></text>

        </element>

        <element
            kind="staticText"
            x="100"
            width="110"
            height="30">

            <text><![CDATA[Customer]]></text>

        </element>

        <element
            kind="staticText"
            x="210"
            width="95"
            height="30">

            <text><![CDATA[Account]]></text>

        </element>

        <element
            kind="staticText"
            x="305"
            width="90"
            height="30">

            <text><![CDATA[Amount]]></text>

        </element>

        <element
            kind="staticText"
            x="395"
            width="160"
            height="30">

            <text><![CDATA[Rejection Reason]]></text>

        </element>

    </columnHeader>

    <detail>

        <band height="30">

            <element
                kind="textField"
                x="0"
                width="100"
                height="30">

                <expression>
                    <![CDATA[$F{cheque_number}]]>
                </expression>

            </element>

            <element
                kind="textField"
                x="100"
                width="110"
                height="30">

                <expression>
                    <![CDATA[$F{customer_name}]]>
                </expression>

            </element>

            <element
                kind="textField"
                x="210"
                width="95"
                height="30">

                <expression>
                    <![CDATA[$F{account_number}]]>
                </expression>

            </element>

            <element
                kind="textField"
                x="305"
                width="90"
                height="30"
                pattern="#,##0.00">

                <expression>
                    <![CDATA[$F{cheque_amount}]]>
                </expression>

            </element>

            <element
                kind="textField"
                x="395"
                width="160"
                height="30">

                <expression>
                    <![CDATA[$F{rejection_reason}]]>
                </expression>

            </element>

        </band>

    </detail>

</jasperReport>